{
  "name": "@common/shared-ui",
  "version": "1.1.0",
  "description": "Shared Svelte 5 UI components, modals, widgets, toast notifications, and UI stores",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stores/uistore": {
      "types": "./dist/stores/uistore.d.ts",
      "default": "./dist/stores/uistore.js"
    },
    "./state/toastState": {
      "types": "./dist/state/toastState.svelte.d.ts",
      "default": "./dist/state/toastState.svelte.js"
    },
    "./theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src/styles/theme.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.56.1",
    "typescript": "^5.4.0"
  }
}
